Online Shopping Discount and Delivery System
#include <iostream>
using namespace std;

int main()
{
    float purchase, discount = 0, amount;
    int premium, unpaid;

    cout << "Enter Purchase Amount: ";
    cin >> purchase;

    cout << "Premium Member (1 Yes, 0 No): ";
    cin >> premium;

    cout << "Unpaid Previous Order (1 Yes, 0 No): ";
    cin >> unpaid;

    if (purchase > 50000)
        discount = 20;
    else if (purchase > 25000)
        discount = 15;
    else if (purchase > 10000)
        discount = 10;
    else
        discount = 0;

    if (premium == 1)
        discount = discount + 5;

    amount = purchase - (purchase * discount / 100);

    if (amount > 20000)
        amount = amount;
    else
        amount = amount + 500;

    cout << "Payable Amount: " << amount << endl;

    if (unpaid == 1)
        cout << "Order Not Confirmed";
    else
        cout << "Order Confirmed";

    return 0;
}